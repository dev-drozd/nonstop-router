{
  "name": "nonstop-router",
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first LLM gateway with transparent key and model failover for AI coding tools (OpenCode, Claude Code, Codex, Cline, Aider, Continue, Zed).",
  "main": "dist/server/index.js",
  "bin": {
    "nonstop-router": "./bin/nonstop-router.js"
  },
  "files": [
    "dist",
    "bin",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "prepublishOnly": "npm run build",
    "start": "node dist/server/index.js"
  },
  "keywords": [
    "llm",
    "gateway",
    "router",
    "failover",
    "opencode",
    "claude-code",
    "codex",
    "cursor",
    "cline",
    "aider",
    "continue",
    "zed",
    "openai",
    "anthropic",
    "prompt-cache",
    "llm-proxy",
    "ai-gateway"
  ],
  "author": "Skr Electronics Lab <skraihan536@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/skr-electronics-lab/nonstop-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skr-electronics-lab/nonstop-router.git"
  },
  "bugs": {
    "url": "https://github.com/skr-electronics-lab/nonstop-router/issues"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.7.4",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@lobehub/icons": "5.23.1",
    "@tanstack/react-query": "^5.67.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
